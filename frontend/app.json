{
  "expo": {
    "name": "Lumina Auth",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luminaauth",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.totpguard.jywofq",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan 2FA QR codes to add accounts",
        "NSFaceIDUsageDescription": "Unlock your Lumina vault"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.totpguard.jywofq",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Lumina Auth to scan 2FA QR codes"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your Lumina vault"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 1080,
          "resizeMode": "cover",
          "backgroundColor": "#050505"
        }
      ],
      "expo-localization"

    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0ec0d25b-fc9b-4c47-a098-a97d0bc8b5e3"
      }
    }
  }
}
